[{"title":"list_files","content":"\n    List all files and directories recursively in the Jupyter server's file system.\n    Used to explore the file system structure of the Jupyter server or to find specific files or directories.\n    ","url":"/mcp/reference/#operation-list-files-tool","method":"tool","path":"list_files","tab":"MCP Explorer","category":"Endpoints"},{"title":"list_kernels","content":"List all available kernels in the Jupyter server.\n\n    This tool shows all running and available kernel sessions on the Jupyter server,\n    including their IDs, names, states, connection information, ","url":"/mcp/reference/#operation-list-kernels-tool","method":"tool","path":"list_kernels","tab":"MCP Explorer","category":"Endpoints"},{"title":"use_notebook","content":"Use a notebook and activate it for following cell operations.\n    All cell operations will be performed on the currently activated notebook.\n    Activate new notebook will deactivate the previously ac","url":"/mcp/reference/#operation-use-notebook-tool","method":"tool","path":"use_notebook","tab":"MCP Explorer","category":"Endpoints"},{"title":"list_notebooks","content":"List all notebooks that have been used via use_notebook tool","url":"/mcp/reference/#operation-list-notebooks-tool","method":"tool","path":"list_notebooks","tab":"MCP Explorer","category":"Endpoints"},{"title":"restart_notebook","content":"Restart the kernel for a specific notebook.","url":"/mcp/reference/#operation-restart-notebook-tool","method":"tool","path":"restart_notebook","tab":"MCP Explorer","category":"Endpoints"},{"title":"unuse_notebook","content":"Unuse from a specific notebook and release its resources.","url":"/mcp/reference/#operation-unuse-notebook-tool","method":"tool","path":"unuse_notebook","tab":"MCP Explorer","category":"Endpoints"},{"title":"read_notebook","content":"Read a notebook and return index, source content, type, execution count of each cell.\n\n    Using brief format to get a quick overview of the notebook structure and it's useful for locating specific ce","url":"/mcp/reference/#operation-read-notebook-tool","method":"tool","path":"read_notebook","tab":"MCP Explorer","category":"Endpoints"},{"title":"insert_cell","content":"Insert a cell to specified position from the currently activated notebook.","url":"/mcp/reference/#operation-insert-cell-tool","method":"tool","path":"insert_cell","tab":"MCP Explorer","category":"Endpoints"},{"title":"overwrite_cell_source","content":"Replace the entire source of a cell in the currently activated notebook.\n    Returns a diff showing the changes made.\n\n    Use this when rewriting a cell completely. For small, targeted changes,\n    p","url":"/mcp/reference/#operation-overwrite-cell-source-tool","method":"tool","path":"overwrite_cell_source","tab":"MCP Explorer","category":"Endpoints"},{"title":"edit_cell_source","content":"Perform a surgical find-and-replace within a cell's source (like an editor's Edit tool).\n    Finds `old_string` in the cell and replaces it with `new_string`. Matching is literal\n    (not regex) and m","url":"/mcp/reference/#operation-edit-cell-source-tool","method":"tool","path":"edit_cell_source","tab":"MCP Explorer","category":"Endpoints"},{"title":"execute_cell","content":"Execute a cell from the currently activated notebook with timeout and return it's outputs","url":"/mcp/reference/#operation-execute-cell-tool","method":"tool","path":"execute_cell","tab":"MCP Explorer","category":"Endpoints"},{"title":"insert_execute_code_cell","content":"Insert a cell at specified index from the currently activated notebook and then execute it with timeout and return it's outputs\n    It is a shortcut tool for insert_cell and execute_cell tools, recomm","url":"/mcp/reference/#operation-insert-execute-code-cell-tool","method":"tool","path":"insert_execute_code_cell","tab":"MCP Explorer","category":"Endpoints"},{"title":"read_cell","content":"Read a specific cell from the currently activated notebook and return i